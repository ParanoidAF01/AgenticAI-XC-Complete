{
  "_description": "Maps CSV error categories to our 6 self-healing types based on ACTUAL CSV data.",
  "_types_reference": {
    "1": "Parameter Errors — Escalate",
    "2": "Dataset Type Errors — Escalate",
    "3": "Credentials Expired — Auto-restart",
    "4": "Large Data / Timeout — Auto-restart",
    "5": "Server Slow — Auto-restart",
    "6": "Subscription Corrupt — Escalate"
  },

  "Azure Databricks": {
    "default_type": 1,
    "overrides": {
      "3200": { "type": 3, "reason": "Access token expired" },
      "3202": { "type": 5, "reason": "Rate limit / throttling / unauthorized access" },
      "3203": { "type": 5, "reason": "Cluster terminated / unavailable" },
      "3204": { "type": 4, "reason": "Job execution failed" },
      "3208": { "type": 5, "reason": "Network connection interrupted" }
    }
  },

  "Azure Data Lake Analytics": {
    "default_type": 1,
    "overrides": {
      "2709": { "type": 5, "reason": "Throttling / wrong tenant / rate limit" },
      "2705": { "type": 3, "reason": "ACL verification failed / unauthorized" },
      "2711": { "type": 3, "reason": "ACL verification failed / file not found" },
      "2704": { "type": 3, "reason": "ACL verification failed" },
      "2703": { "type": 4, "reason": "Internal system error from ADLA" }
    }
  },

  "Azure functions": {
    "default_type": 1,
    "overrides": {
