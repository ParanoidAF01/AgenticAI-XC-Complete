# ============================================================
# Ontology Chatbot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- PostgreSQL (Application Database) ---
POSTGRES_URL=postgresql+asyncpg://ontology_user:changeme@localhost:5432/ontology_chatbot

# --- Redis (Cache) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-random-64-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM (Anthropic) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=your-anthropic-api-key-here
LLM_ENDPOINT=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_VERSION=2023-06-01

# --- Neo4j (Ontology Graph) ---
NEO4J_URI=neo4j+s://your-neo4j-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# --- MSSQL Database Profiles (Full Connection URLs) ---
# Format: mssql+pyodbc://user:password@server:port/database?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
MSSQL_IDP_REPORTING_URL=mssql+pyodbc://readonly_user:password@server:1433/idp_reporting?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
MSSQL_IDP_STAGE_EXT_URL=mssql+pyodbc://readonly_user:password@server:1433/idp_stage_ext?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
